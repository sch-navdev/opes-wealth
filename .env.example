# Copy to .env.local for local development. Never commit real values.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Canonical site URL (REQUIRED in production) ---
# Used for every Supabase Auth email redirect (sign-up confirmation, password
# reset). Must be set manually in the Vercel dashboard (Project Settings ->
# Environment Variables) — it is not derived from the deployment. Should match
# the domain your passkeys/auth are registered under. No trailing slash needed.
NEXT_PUBLIC_SITE_URL=https://www.opeswealth.app

# --- UAE Open Finance (Al Tareq) bank sync — server-side only, all optional ---
# Without credentials the "Connect bank" button is disabled. See
# src/lib/banking/altareq.ts: the live connection needs provider onboarding and
# mTLS certificates and is not implemented yet; ALTAREQ_SANDBOX_MODE=true gives
# SANDBOX banks for development (tagged Sandbox, never touching your accounts or net worth).
ALTAREQ_SANDBOX_MODE=
ALTAREQ_CLIENT_ID=
ALTAREQ_AUTH_URL=
ALTAREQ_TOKEN_URL=
ALTAREQ_API_BASE_URL=
# Registered redirect, e.g. https://www.opeswealth.app/dashboard/banking/callback
ALTAREQ_REDIRECT_URI=
ALTAREQ_CLIENT_CERT=
ALTAREQ_CLIENT_KEY=
# 32 random bytes, base64 — encrypts stored bank tokens (AES-256-GCM):
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BANK_TOKEN_ENCRYPTION_KEY=
# Required in production for bank sync (server-only; never NEXT_PUBLIC_):
# SUPABASE_SERVICE_ROLE_KEY is used to read/write the encrypted token columns.

# --- Local-only dev auth bypass (see src/utils/supabase/mock-auth.ts) ---
# Only takes effect under `next dev`. Never set these in Vercel/production.
NEXT_PUBLIC_MOCK_AUTH=
MOCK_AUTH_USER_ID=
SUPABASE_SERVICE_ROLE_KEY=

# --- AI help assistant (floating chat) + daily bug flush ---
ANTHROPIC_API_KEY=
# Optional; default claude-sonnet-5-5
ASSISTANT_MODEL=
# Vercel Cron sends this as "Authorization: Bearer ..." to /api/cron/bug-reports
CRON_SECRET=
# Where the daily bug flush pushes (either or both; GitHub wins if both):
GITHUB_ISSUES_TOKEN=
# owner/name
GITHUB_ISSUES_REPO=
BUG_REPORT_WEBHOOK_URL=
