# Copy to .env.local for local development. Never commit real values.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Canonical site URL (REQUIRED in production) ---
# Used for every Supabase Auth email redirect (sign-up confirmation, password
# reset). Must be set manually in the Vercel dashboard (Project Settings ->
# Environment Variables) — it is not derived from the deployment. Should match
# the domain your passkeys/auth are registered under. No trailing slash needed.
NEXT_PUBLIC_SITE_URL=https://www.opeswealth.app

# --- Local-only dev auth bypass (see src/utils/supabase/mock-auth.ts) ---
# Only takes effect under `next dev`. Never set these in Vercel/production.
NEXT_PUBLIC_MOCK_AUTH=
MOCK_AUTH_USER_ID=
SUPABASE_SERVICE_ROLE_KEY=
